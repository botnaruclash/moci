# get.bytemochi.com — the campaign page (/), the results (/results), the form's API and the team's /internal pages.

# The two sites' origins (src/lib/sites.ts). Unset locally: http://localhost:3100 and http://localhost:3200.
# Set both before any deploy: https://bytemochi.com and https://get.bytemochi.com
NEXT_PUBLIC_BRAND_URL=
NEXT_PUBLIC_GET_URL=

# ---- Backend: OFF unless this is 1 (src/server/backend.ts) --------------------------------------------------------
# Off: no database, no Telegram, no PayPal — the form answers with an unsaved LOCAL-xxxxxx reference.
# Turn on only with Bytemochi's own accounts below. Never reuse Splendessa's.
BACKEND_ENABLED=

# Neon Postgres (server-side only). Run the migrations in db/ with scripts/db-migrate.mjs on a new database.
DATABASE_URL=

# Telegram: the BotFather token and the two private channels' ids (scripts/telegram-chats.mjs).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_PAID=
TELEGRAM_CHAT_FREE=

# PayPal (src/server/paypal.ts has the full list and rules).
PAYPAL_ENV=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
PAYPAL_PUBLIC_CHECKOUT=

# Scheduled reconcile (vercel.json cron) and the team's /internal login (scripts/team-user.mjs).
CRON_SECRET=
TEAM_USERS=
TEAM_SESSION_SECRET=
TEAM_TIMEZONE=
INTERNAL_BASE_URL=

NEXT_PUBLIC_ENABLE_LAB=
