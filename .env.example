# moci-web — a static landing page. No backend, no database, no payments, no tracking: the form is a local demo.

# Public origin for the canonical link, Open Graph URLs and the share image (src/lib/sites.ts).
# Unset: https://moci.md. Set it only to publish under another address (for example a preview URL).
NEXT_PUBLIC_SITE_URL=

# 1 turns on the /lab tools and the grid overlay in a production build (development always has them). Leave empty.
NEXT_PUBLIC_ENABLE_LAB=
